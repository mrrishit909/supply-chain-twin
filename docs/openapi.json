 "components": {
  "schemas": {
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "PlanIn": {
    "properties": {
     "scenario_id": {
      "type": "string",
      "format": "uuid",
      "title": "Scenario Id"
     },
     "runs": {
      "type": "integer",
      "maximum": 2000.0,
      "minimum": 100.0,
      "title": "Runs",
      "default": 500
     }
    },
    "type": "object",
    "required": [
     "scenario_id"
    ],
    "title": "PlanIn"
   },
   "RunIn": {
    "properties": {
     "runs": {
      "type": "integer",
      "maximum": 5000.0,
      "minimum": 100.0,
      "title": "Runs",
      "default": 1000
     }
    },
    "type": "object",
    "title": "RunIn"
   },
   "ScenarioIn": {
    "properties": {
     "name": {
      "type": "string",
      "maxLength": 120,
      "minLength": 3,
      "title": "Name"
     },
     "event_type": {
      "type": "string",
      "pattern": "^port_capacity_reduction$",
      "title": "Event Type",
      "description": "The one disruption type modelled in this build"
     },
     "facility": {
      "type": "string",
      "title": "Facility",
      "description": "Port name, e.g. Shanghai"
     },
     "severity": {
      "type": "number",
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Severity",
      "description": "Share of port capacity lost"
     },
     "duration_days": {
      "type": "integer",
      "maximum": 60.0,
      "minimum": 1.0,
      "title": "Duration Days"
     }
    },
    "type": "object",
    "required": [
     "name",
     "event_type",
     "facility",
     "severity",
     "duration_days"
    ],
    "title": "ScenarioIn"
   },
   "ValidationError": {
    "properties": {
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "type": "array",
      "title": "Location"
     },
     "msg": {
      "type": "string",
      "title": "Message"
     },
     "type": {
      "type": "string",
      "title": "Error Type"
     },
     "input": {
      "title": "Input"
     },
     "ctx": {
      "type": "object",
      "title": "Context"
     }
    },
    "type": "object",
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError"
   }
  }
 }
